# apo self-hosted alpha — environment template
#
# Copy to .env and fill in real values before running:
#   cp .env.example .env
#   docker compose up -d --build
#
# AUTH_SECRET is always required. The public Server Profile also requires
# APO_PUBLIC_URL; the local profile uses the defaults shown below.

# --- Required ---

# JWT signing secret shared between frontend and backend.
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# --- Deployment profile ---
#
# Local (default): Docker ports are bound only to 127.0.0.1.
# Public server: set both values below, point the hostname's DNS at this host,
# then apply docker-compose.server.yml. APO_PUBLIC_URL must be an origin with no
# path, for example https://apo.example.com.
APO_DEPLOYMENT_PROFILE=local
APO_PUBLIC_URL=
# Public server example:
#APO_DEPLOYMENT_PROFILE=server
#APO_PUBLIC_URL=https://apo.example.com

# --- Optional: database ---
#
# By default the stack uses SQLite (a single file under the apo_db volume),
# identical to local dev — no extra configuration needed. To run Postgres
# instead, apply docker-compose.postgres.yml and set a password here:
#   docker compose -f docker-compose.yml -f docker-compose.postgres.yml up -d --build
#POSTGRES_PASSWORD=         # openssl rand -hex 16
#POSTGRES_DB=apo

# --- Optional: data size control (SQLite only) ---
#
# Age out traces/runs older than N days (0 = disabled). Recommended: 90.
# A daily background job prunes old data and VACUUMs to reclaim space.
#APO_RETENTION_DAYS=0
# Hard ceiling on the DB file size, in 4 KiB pages (0 = unlimited).
# e.g. 262144 pages ~= 1 GiB. Writes fail once the cap is hit.
#APO_MAX_DB_PAGES=0

# --- Task Run Deliverables / Artifacts ---
#
# Deliverable metadata stays in the database; large JSON bodies and file
# Artifacts go through an ArtifactStore. The default `local` backend writes
# under /app/data (the existing persistent volume) — no extra service required.
#APO_ARTIFACT_STORE=local         # local | s3
#APO_ARTIFACT_DIR=                # default: <DATA_DIR>/artifacts
#APO_ARTIFACT_MAX_ITEM_BYTES=104857600   # 100 MiB per Artifact
#APO_ARTIFACT_MAX_RUN_BYTES=524288000    # 500 MiB ready+pending per Task Run
#APO_ARTIFACT_UPLOAD_TTL_SECONDS=86400   # pending-upload expiry
# Optional S3-compatible backend (sets APO_ARTIFACT_STORE=s3 to use it):
#APO_S3_BUCKET=
#APO_S3_REGION=
#APO_S3_ENDPOINT_URL=             # R2 / MinIO / Backblaze etc.
#APO_S3_PREFIX=artifacts/
#APO_S3_ACCESS_KEY_ID=            # omit to use the provider credential chain
#APO_S3_SECRET_ACCESS_KEY=
#APO_S3_FORCE_PATH_STYLE=false
# NOTE: a database-only backup is no longer complete once object-backed
# Deliverables exist — back up /app/data/artifacts (or the S3 bucket) too.

# --- Optional: first-user bootstrap ---
#
# When set, the backend creates one admin user on first boot (idempotent —
# no-op once any users exist). Normal onboarding is account creation via
# the dashboard + project invite (Settings → Members).
#INIT_USER_EMAIL=admin@example.com
#INIT_USER_PASSWORD=ChangeMe123
#INIT_USER_NAME=Admin

# --- Optional: email delivery ---
#
# Off (log-only) by default: invitations fall back to copy-link and
# password-reset links are printed to the backend logs. When set, invite,
# password-reset, and verification emails are delivered via SMTP.
# Works with any provider's SMTP relay, e.g. Resend (free tier):
#   EMAIL_TRANSPORT_URL=smtp://resend:re_YOUR_API_KEY@smtp.resend.com:587
# Port 465 = implicit TLS, 587 = STARTTLS (auto-detected).
#EMAIL_TRANSPORT_URL=
#EMAIL_FROM_ADDRESS=noreply@yourdomain.com
#EMAIL_FROM_NAME=apo

# --- Optional: LLM provider ---
#
# Required only for running real agent tasks (the demo workspace and
# structural tests do not need it). When unset, task runs that call an
# LLM will fail with a clear operator-grade error.
#OPENROUTER_API_KEY=sk-or-v1-...
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#AGENT_TASK_OPENROUTER_MODEL=google/gemini-2.5-flash-lite
