{
  "name": "@apo-ai/sdk",
  "version": "0.5.0",
  "description": "TypeScript SDK for testing and observing AI agents with Apo",
  "keywords": [
    "ai-agents",
    "agent-testing",
    "agent-evaluation",
    "agent-evals",
    "evals",
    "llm",
    "llm-judge",
    "e2e-testing",
    "testing-framework",
    "opentelemetry",
    "tracing",
    "vercel-ai-sdk",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samikuikka/apo.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://docs.test-apo.online/",
  "bugs": {
    "url": "https://github.com/samikuikka/apo/issues"
  },
  "exports": {
    "./otel": {
      "development": "./src/otel/index.ts",
      "types": "./dist/otel/index.d.ts",
      "default": "./dist/otel/index.js"
    },
    "./agent-task": {
      "development": "./src/agent-task/public.ts",
      "types": "./dist/agent-task/public.d.ts",
      "default": "./dist/agent-task/public.js"
    },
    "./agent-task/integrations/ai-sdk": {
      "development": "./src/agent-task/integrations/ai-sdk.ts",
      "types": "./dist/agent-task/integrations/ai-sdk.d.ts",
      "default": "./dist/agent-task/integrations/ai-sdk.js"
    },
    "./agent-task/integrations/openai": {
      "development": "./src/agent-task/integrations/openai.ts",
      "types": "./dist/agent-task/integrations/openai.d.ts",
      "default": "./dist/agent-task/integrations/openai.js"
    },
    "./agent-task/integrations/anthropic": {
      "development": "./src/agent-task/integrations/anthropic.ts",
      "types": "./dist/agent-task/integrations/anthropic.d.ts",
      "default": "./dist/agent-task/integrations/anthropic.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      "./otel": {
        "types": "./dist/otel/index.d.ts",
        "import": "./dist/otel/index.js",
        "default": "./dist/otel/index.js"
      },
      "./agent-task": {
        "types": "./dist/agent-task/public.d.ts",
        "import": "./dist/agent-task/public.js",
        "default": "./dist/agent-task/public.js"
      },
      "./agent-task/integrations/ai-sdk": {
        "types": "./dist/agent-task/integrations/ai-sdk.d.ts",
        "import": "./dist/agent-task/integrations/ai-sdk.js",
        "default": "./dist/agent-task/integrations/ai-sdk.js"
      },
      "./agent-task/integrations/openai": {
        "types": "./dist/agent-task/integrations/openai.d.ts",
        "import": "./dist/agent-task/integrations/openai.js",
        "default": "./dist/agent-task/integrations/openai.js"
      },
      "./agent-task/integrations/anthropic": {
        "types": "./dist/agent-task/integrations/anthropic.d.ts",
        "import": "./dist/agent-task/integrations/anthropic.js",
        "default": "./dist/agent-task/integrations/anthropic.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.type-tests.json",
    "build": "tsup",
    "prepare": "test ! -f tsup.config.ts || test ! -x node_modules/.bin/tsup || pnpm run build",
    "build:watch": "tsup --watch",
    "build:agent-task-runtime": "node scripts/build-agent-task-runtime.mjs",
    "prepack": "pnpm run build",
    "package:check": "node scripts/verify-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.7.1",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.21.5",
    "publint": "^0.3.22",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.9",
    "zod": "^3.22.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.9.0",
    "@opentelemetry/core": "^2.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  }
}
