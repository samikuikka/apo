{
  "name": "@apo-ai/cli",
  "version": "0.8.0",
  "description": "CLI for Apo — the end-to-end testing framework for AI agents. Run tasks, read pass/fail verdicts, and inspect traces.",
  "keywords": [
    "ai-agents",
    "agent-testing",
    "agent-evaluation",
    "agent-evals",
    "evals",
    "llm",
    "cli",
    "e2e-testing",
    "developer-tools"
  ],
  "type": "module",
  "bin": {
    "apo": "./dist/main.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samikuikka/apo.git",
    "directory": "packages/cli"
  },
  "homepage": "https://docs.test-apo.online/",
  "bugs": {
    "url": "https://github.com/samikuikka/apo/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepack": "pnpm run build",
    "package:check": "node scripts/verify-package.mjs",
    "apo": "node --experimental-strip-types --conditions development src/main.ts",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'tests/connect-scene.test.ts'",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@apo-ai/sdk": "^0.5.0",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "publint": "^0.3.22",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.9"
  }
}
