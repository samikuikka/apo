# one Caddyfile for both ingress modes.
#
# Direct mode: APO_CADDY_SITE_ADDRESS is the public HTTPS origin; Caddy
# manages TLS. Tunnel mode: APO_CADDY_SITE_ADDRESS is :8080; Cloudflare
# terminates public TLS and the cloudflared connector sends traffic here.
#
# The exact route matrix (OTLP, public health, diagnostic denials, frontend
# fallback) is identical in both modes.
#
# The ingress owns transport, not identity. Admission shells
# (/login, /join) and CLI routes (/auth/*, /v1/*) reach the application
# unauthenticated; Apo's session/API-key auth and Project authorization are
# the only security boundary.
{
	servers {
		timeouts {
			read_header {$APO_HTTP_READ_HEADER_TIMEOUT_SECONDS:10}s
		}
		trusted_proxies static {$APO_TRUSTED_PROXY_RANGES:192.0.2.0/24}
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# Host-routed blocks on the tunnel listener (:8080). The explicit http://
# scheme plus port keeps these on the same plain-HTTP listener cloudflared
# targets: a bare hostname would default to :443, where no tunnel traffic
# ever arrives, and Caddy would retry ACME forever (certmagic manages any
# configured hostname unless the scheme is explicitly http://). The
# docs/umami overlays only ride the tunnel stack, so this is fixed by
# construction.
http://{$APO_DOCS_HOST}:8080 {
	# Public docs host is terminal, unauthenticated, static only.
	# Every path on this host proxies to the docs container and never
	# reaches the backend, OTLP handler, or readiness probe.
	handle {
		encode zstd gzip
		reverse_proxy docs:8080
	}
}

http://{$APO_UMAMI_HOST}:8080 {
	# Umami analytics host is terminal at the ingress. Umami owns its admin
	# auth; the beacon endpoint it serves is public by design. No Apo
	# secret crosses this boundary.
	handle {
		encode zstd gzip
		reverse_proxy umami:3000
	}
}

{$APO_CADDY_SITE_ADDRESS} {
	# exact canonical OTLP handler — direct to backend.
	handle /api/public/otel/v1/traces {
		request_body {
			max_size {$APO_TELEMETRY_MAX_REQUEST_BYTES:10485760}
		}
		reverse_proxy backend:8000
	}

	# exact public health — detail-free readiness probe.
	handle /api/public/health {
		reverse_proxy backend:8000
	}

	# deny raw operator diagnostic aliases through public ingress.
	@raw_diagnostics path /backend-proxy/health/ready /backend-proxy/docs /backend-proxy/openapi.json /backend-proxy/hello /api/health/ready
	handle @raw_diagnostics {
		respond 404
	}

	# API proxy path — backend handles its own auth (API key or session).
	# Keep this after the diagnostic denials: handle blocks are mutually
	# exclusive, so the broad prefix would otherwise make the denials unreachable.
	#
	# Issue #174: API traffic goes straight to the backend. Routing it through
	# the frontend's Next rewrite added a 30 s proxy timeout and a second Node
	# buffer, so multi-MB CLI result submissions died as bodyless 500s and their
	# runs were later reaped as errors. The frontend adds no auth on this path
	# (the backend validates session/API key itself) and its server components
	# already bypass the rewrite via the internal BACKEND_URL. No `encode`
	# here: compression buffers the SSE run/trace feeds behind this prefix
	# (same lesson as `compress: false` in next.config.mjs). Caddy's
	# reverse_proxy has no response timeout by default.
	handle_path /backend-proxy/* {
		reverse_proxy backend:8000
	}

	# Backend-owned paths on the public origin: `apo login --backend
	# <origin>` calls /v1/* and /auth/* directly — same rule as above: straight
	# to the backend, no frontend hop, no 30 s timeout on heavy submissions.
	handle /v1/* {
		reverse_proxy backend:8000
	}

	handle /auth/* {
		reverse_proxy backend:8000
	}

	# Everything else (dashboard pages, admission shells, CLI rewrites) goes
	# to the frontend, which enforces application authentication. There is no
	# ingress-level Basic Auth: OG images and crawler previews work through the
	# same path, protected by the application's bounded card API.
	handle {
		encode zstd gzip
		reverse_proxy frontend:3000
	}
}
