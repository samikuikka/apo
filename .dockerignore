.git/
# Bare `node_modules/` matches only the repo root; nested workspace
# installs (apps/dashboard/node_modules, …) must be excluded too or COPY
# shadows the image's own pnpm links with host-local ones.
node_modules/
**/node_modules/
.next/
__pycache__/
.uv-cache/
*.pyc
# Match .env at any depth. A bare `.env` only excludes the repo-root file,
# so a local `backend/.env` slips into the image via `COPY backend/` as
# root-owned `/app/.env` and crashes the appuser-owned uvicorn with
# PermissionError on load_dotenv(). `**/.env` covers every nested copy.
.env
**/.env
.env.*
data/
backend/data/
