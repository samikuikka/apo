---
/**
 * Landing page — the standalone full-width product page at `/`.
 *
 * Bypasses Starlight's docs layout entirely (no sidebar, no docs header tabs):
 * a centered hero, full-width sections, and the same dark/monochrome token
 * system as the rest of the docs. Astro's `src/pages/` routes override
 * Starlight's generated content routes, so this owns `/`.
 *
 * Structure mirrors flue's landing page (hero → CTA → demo → features → footer)
 * rendered in apo's dark/sharp-cornered identity. Animations are CSS keyframes
 * + IntersectionObserver reveals — the established docs idiom, no framer-motion.
 */
import "../styles/custom.css";
import { SignalSphereIsland } from "../components/brand/SignalSphereIsland.tsx";
import CopyPromptButton from "../components/CopyPromptButton.astro";
import RunDetailMock from "../components/RunDetailMock.astro";
import LandingFeatures from "../components/LandingFeatures.astro";
import { docsSections, docsHref } from "../lib/docs-navigation";

const GITHUB_URL = "https://github.com/samikuikka/apo";
const COPY_PROMPT_TEXT =
	`Read ${Astro.site}start.md then help me set up apo and run my first task.`;

// Open Graph / Twitter card metadata. The preview image is generated at build
// time by src/pages/og-landing.png.ts — see that file for the design. Keep these
// in sync with the <title>/<meta description> below (single source via consts).
const PAGE_TITLE = "apo — Capability testing for agent harnesses";
const PAGE_DESCRIPTION =
	"Executable capability specifications for agent harnesses. Define what your agent must be capable of, run the real system, verify the outcome — and engineer the harness until it passes.";
const OG_IMAGE = new URL("/og-landing.png", Astro.site).href;
const CANONICAL = new URL("/", Astro.site).href;

// PROTOTYPE — "Where apo fits" section variants, switchable via ?variant=.
// Dev-only: variants B/C and the switcher are stripped from production builds.
const PROTO = !import.meta.env.PROD;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{PAGE_TITLE}</title>
		<meta name="description" content={PAGE_DESCRIPTION} />
		<link rel="canonical" href={CANONICAL} />
		<link rel="icon" href="/brand/signal-sphere-favicon-32.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		{/* Open Graph — what Facebook, LinkedIn, Slack, etc. render. */}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="apo" />
		<meta property="og:title" content={PAGE_TITLE} />
		<meta property="og:description" content={PAGE_DESCRIPTION} />
		<meta property="og:url" content={CANONICAL} />
		<meta property="og:image" content={OG_IMAGE} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="apo — capability testing for agent harnesses" />
		{/* Twitter / X — summary_large_image gives the big banner card. */}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={PAGE_TITLE} />
		<meta name="twitter:description" content={PAGE_DESCRIPTION} />
		<meta name="twitter:image" content={OG_IMAGE} />
		{/* Structured data for search engines — what the product is and where
		    it lives (repo, npm packages, docs). */}
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "SoftwareApplication",
				name: "apo",
				applicationCategory: "DeveloperApplication",
				operatingSystem: "Linux, macOS, Docker",
				description: PAGE_DESCRIPTION,
				url: CANONICAL,
				sameAs: [
					GITHUB_URL,
					"https://www.npmjs.com/package/@apo-ai/sdk",
					"https://www.npmjs.com/package/@apo-ai/cli",
				],
				offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
				featureList: [
					"Binary pass/fail verdicts with test breakdown",
					"Code assertions and LLM judges on agent deliverables",
					"Full runtime traces for every run",
					"Adapters for any agent stack (Vercel AI SDK, OpenAI, Anthropic, custom)",
					"Self-hosted, source-open",
				],
			})}
		/>
	</head>
	<body>
		<!-- Nav — matches the docs header: brand mark + wordmark, section tabs,
		     GitHub icon. Same structure/styling so / and /overview/ feel seamless. -->
		<nav class="landing-nav" aria-label="Primary">
			<div class="landing-nav__left">
				<a class="landing-nav__brand" href="/" aria-label="apo — home">
					<img
						class="landing-nav__mark"
						src="/brand/signal-sphere-small.svg"
						alt=""
						aria-hidden="true"
					/>
					<span class="landing-nav__wordmark">apo</span>
				</a>
				<div class="landing-nav__tabs">
					{docsSections.map((section) => (
						<a
							class="landing-nav__tab"
							href={docsHref(section.landingSlug)}
						>
							{section.title}
						</a>
					))}
				</div>
			</div>
			<div class="landing-nav__right">
				<a
					class="landing-nav__github"
					href={GITHUB_URL}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="GitHub repository"
				>
					<svg viewBox="0 0 24 24" aria-hidden="true" class="landing-nav__github-icon">
						<path
							fill="currentColor"
							d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.7.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"
						/>
					</svg>
				</a>
			</div>
		</nav>

		<main>
			<!-- Hero — title + animated sphere side by side. -->
			<section class="landing-section landing-section--hero">
				<div class="landing-container landing-hero">
					<div class="landing-hero__text">
						<span class="landing-alpha-badge">Public Alpha</span>
						<h1 class="landing-hero__title">
							Define what your agent must be capable of.
						</h1>
						<p class="landing-hero__sub">
							Executable specifications. Real agent runs. Pass or fail with evidence.
						</p>
						<div class="landing-cta">
							<CopyPromptButton text={COPY_PROMPT_TEXT} />
							<a
								class="landing-cta__github"
								href={GITHUB_URL}
								target="_blank"
								rel="noopener noreferrer"
							>
								<svg viewBox="0 0 24 24" aria-hidden="true" class="landing-cta__github-icon">
									<path
										fill="currentColor"
										d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.7.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"
									/>
								</svg>
								<span>Star on GitHub</span>
							</a>
						</div>
					</div>
					<div class="landing-hero__visual">
						<SignalSphereIsland client:load size={260} />
					</div>
				</div>
			</section>

			<!-- Where apo fits — PROTOTYPE variants. A ships today; B/C are
			     dev-only (?variant=B / ?variant=C). -->
			<section class="landing-section landing-section--bordered" data-landing-cats data-variant="A">
				<div class="landing-container">
					<h2 class="landing-section__heading">Where apo fits</h2>
					<p class="landing-section__sub">Three categories, three different questions.</p>
					<div class="landing-cats">
						<article class="cat" style="--i: 0">
							<span class="cat__kind">Testing libraries</span>
							<h3 class="cat__q">Did this run pass?</h3>
							<div class="cat__gliff" aria-hidden="true">
								<span class="cat__row">run → expect() <span class="cat__ok">✓</span></span>
								<span class="cat__row">run → expect() <span class="cat__bad">✗</span></span>
							</div>
							<span class="cat__names">DeepEval · Promptfoo</span>
						</article>
						<article class="cat" style="--i: 1">
							<span class="cat__kind">Observability platforms</span>
							<h3 class="cat__q">What did it do?</h3>
							<div class="cat__gliff cat__gliff--spans" aria-hidden="true">
								<span class="cat__span" style="--w: 78%"></span>
								<span class="cat__span cat__span--child" style="--w: 46%"></span>
								<span class="cat__span" style="--w: 62%"></span>
							</div>
							<span class="cat__names">Langfuse · Arize · Braintrust</span>
						</article>
						<article class="cat cat--apo" style="--i: 2">
							<span class="cat__kind">apo</span>
							<h3 class="cat__q">Can it do the job?</h3>
							<div class="cat__gliff" aria-hidden="true">
								<span class="cat__row">spec → run → <span class="cat__pass">PASS</span></span>
								<span class="cat__row cat__row--return">↺ improve the harness</span>
							</div>
							<span class="cat__names">capability specifications</span>
						</article>
					</div>
					<p class="landing-cats__foot">
						apo starts from the specification. <a href="/why-apo/">The full map →</a>
					</p>
				</div>
			</section>

			{PROTO && (
				<section class="landing-section landing-section--bordered" data-variant="B" hidden>
					<div class="landing-container">
						<h2 class="landing-section__heading">Where the loop starts</h2>
						<p class="landing-section__sub">
							Every tool's pipeline begins somewhere — that decides what it can tell you.
						</p>
						<div class="flows">
							<div class="flow">
								<span class="flow__label">Observability platforms</span>
								<div class="flow__band">
									<span class="flow__node">traffic</span>
									<span class="flow__arrow">→</span>
									<span class="flow__node">traces</span>
									<span class="flow__arrow">→</span>
									<span class="flow__node">datasets</span>
									<span class="flow__arrow">→</span>
									<span class="flow__node">scores</span>
									<span class="flow__arrow">→</span>
									<span class="flow__node">monitor</span>
								</div>
							</div>
							<div class="flow">
								<span class="flow__label">Testing libraries</span>
								<div class="flow__band">
									<span class="flow__node">test case</span>
									<span class="flow__arrow">→</span>
									<span class="flow__node">run</span>
									<span class="flow__arrow">→</span>
									<span class="flow__node">assert</span>
									<span class="flow__arrow">→</span>
									<span class="flow__node">✓/✗</span>
								</div>
							</div>
							<div class="flow flow--apo">
								<span class="flow__label flow__label--apo">apo</span>
								<div class="flow__band flow__band--apo">
									<span class="flow__node flow__node--apo">specification</span>
									<span class="flow__arrow">→</span>
									<span class="flow__node flow__node--apo">run the harness</span>
									<span class="flow__arrow">→</span>
									<span class="flow__node flow__node--apo">PASS / FAIL</span>
									<span class="flow__arrow flow__arrow--return">↺ improve the harness</span>
								</div>
							</div>
						</div>
						<p class="flows__foot">
							apo starts from the specification. <a href="/why-apo/">The full map →</a>
						</p>
					</div>
				</section>
			)}

			{PROTO && (
				<section class="landing-section landing-section--bordered" data-variant="C" hidden>
					<div class="landing-container">
						<div class="manifesto">
							<div class="mani-row">
								<span class="mani__who">testing libraries</span>
								<span class="mani__q">Did this run pass?</span>
							</div>
							<div class="mani-row">
								<span class="mani__who">observability platforms</span>
								<span class="mani__q">What did it do?</span>
							</div>
							<div class="mani-row mani-row--apo">
								<span class="mani__who">apo</span>
								<div class="mani__apo">
									<span class="mani__q mani__q--apo">Can it do the job?</span>
									<span class="mani__sub">
										— and can we engineer it until it can? <a href="/why-apo/">The full map →</a>
									</span>
								</div>
							</div>
						</div>
					</div>
				</section>
			)}

			<!-- The product -->
			<section class="landing-section landing-section--bordered">
				<div class="landing-container">
					<h2 class="landing-section__heading">Pass or fail, with evidence.</h2>
					<p class="landing-section__sub">
						Open a test to see what apo checked.
					</p>
					<RunDetailMock />
				</div>
			</section>

			<!-- Features -->
			<section class="landing-section landing-section--bordered">
				<div class="landing-container">
					<LandingFeatures />
				</div>
			</section>

		</main>

		<footer class="landing-footer">
			<div class="landing-container landing-footer__inner">
				<span>apo — executable capability specifications for agent harnesses.</span>
				<span class="landing-footer__links">
					<a href="/overview/">Docs</a>
					<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
				</span>
			</div>
		</footer>

		{PROTO && (
			<div class="proto-bar" data-proto-bar>
				<button type="button" class="proto-bar__btn" data-proto-prev aria-label="Previous variant">←</button>
				<span class="proto-bar__label" data-proto-label>A</span>
				<button type="button" class="proto-bar__btn" data-proto-next aria-label="Next variant">→</button>
			</div>
		)}

		<script>
			// Stagger the category cards in when the section scrolls into view —
			// same onVisible helper the features bento uses. The import must be
			// inside the script tag to reach the browser.
			import { onVisible } from "../components/demos/demo-motion";

			const cats = document.querySelector<HTMLElement>("[data-landing-cats]");
			if (cats) {
				onVisible(cats, (state) => {
					cats.toggleAttribute("data-visible", state === "visible");
				});
			}
		</script>

		{PROTO && (
			<script>
				// PROTOTYPE switcher — flips the "Where apo fits" variants via ?variant=.
				const VARIANTS = [
					{ key: "A", name: "Three questions (current)" },
					{ key: "B", name: "Where the loop starts" },
					{ key: "C", name: "What each tool asks" },
				];
				const sections = Array.from(
					document.querySelectorAll<HTMLElement>("[data-variant]"),
				);
				const label = document.querySelector<HTMLElement>("[data-proto-label]");

				function currentKey(): string {
					return new URLSearchParams(location.search).get("variant") ?? "A";
				}

				function show(key: string) {
					const known = VARIANTS.some((v) => v.key === key) ? key : "A";
					for (const s of sections) s.hidden = s.dataset.variant !== known;
					const v = VARIANTS.find((x) => x.key === known)!;
					if (label) label.textContent = `${v.key} — ${v.name}`;
					history.replaceState(null, "", `/?variant=${known}`);
				}

				function cycle(dir: 1 | -1) {
					const i = VARIANTS.findIndex((v) => v.key === currentKey());
					const next = VARIANTS[(i + dir + VARIANTS.length) % VARIANTS.length]!;
					show(next.key);
				}

				document
					.querySelector("[data-proto-prev]")
					?.addEventListener("click", () => cycle(-1));
				document
					.querySelector("[data-proto-next]")
					?.addEventListener("click", () => cycle(1));
				document.addEventListener("keydown", (e) => {
					const t = e.target as HTMLElement | null;
					if (
						t &&
						(t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)
					)
						return;
					if (e.key === "ArrowLeft") cycle(-1);
					if (e.key === "ArrowRight") cycle(1);
				});

				show(currentKey());
			</script>
		)}
	</body>
</html>

<style is:global>
	.landing-alpha-badge {
		display: inline-flex;
		align-items: center;
		padding: 0.2rem 0.7rem;
		margin-bottom: 1rem;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--sl-color-gray-3);
		background: var(--sl-color-gray-6);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		text-transform: uppercase;
		white-space: nowrap;
	}

	/* Category cards — three terse cards, one question each. */
	.landing-cats {
		display: grid;
		gap: 1rem;
		grid-template-columns: 1fr;
		max-width: 62rem;
		margin: 0 auto;
	}

	@media (min-width: 40rem) {
		.landing-cats {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.cat {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		min-height: 11rem;
		padding: 1.1rem 1.1rem 0.9rem;
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-gray-6);
	}

	.cat--apo {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low, #0a1a0e);
	}

	.cat__kind {
		font-family: var(--sl-font-mono, ui-monospace, monospace);
		font-size: 0.65rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--sl-color-gray-4);
	}

	.cat--apo .cat__kind {
		color: var(--sl-color-accent-high, #4ade80);
	}

	.cat__q {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--sl-color-gray-1);
	}

	/* Gliffs sit at the card bottom; each represents the category's
	   starting object — assertions, traces, the loop. */
	.cat__gliff {
		margin-top: auto;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.cat__row {
		font-family: var(--sl-font-mono, ui-monospace, monospace);
		font-size: 0.7rem;
		color: var(--sl-color-gray-3);
		white-space: nowrap;
	}

	.cat__row--return {
		color: var(--sl-color-gray-4);
	}

	/* Verdict marks are state — the sanctioned accent use. */
	.cat__ok,
	.cat__pass {
		color: var(--sl-color-accent);
		font-weight: 700;
	}

	.cat__bad {
		color: oklch(0.7 0.16 25);
		font-weight: 700;
	}

	.cat__gliff--spans {
		gap: 0.4rem;
		padding: 0.4rem 0 0.15rem;
	}

	.cat__span {
		display: block;
		height: 0.45rem;
		width: var(--w, 60%);
		background: var(--sl-color-gray-4);
		opacity: 0.75;
	}

	.cat__span--child {
		margin-left: 12%;
		height: 0.35rem;
		background: var(--sl-color-gray-5);
	}

	.cat__names {
		margin-top: 0.75rem;
		padding-top: 0.55rem;
		border-top: 1px solid var(--sl-color-gray-6);
		font-size: 0.7rem;
		color: var(--sl-color-gray-4);
	}

	.cat--apo .cat__names {
		border-top-color: color-mix(in oklab, var(--sl-color-accent) 25%, transparent);
		color: var(--sl-color-gray-3);
	}

	.landing-cats__foot {
		margin-top: 1.5rem;
		text-align: center;
		color: var(--sl-color-gray-3);
	}

	.landing-cats__foot a {
		color: var(--sl-color-accent-high, #4ade80);
	}

	/* Staggered reveal — same idiom as the features bento. */
	.cat {
		opacity: 0;
		transform: translateY(6px);
		transition: opacity 0.35s ease, transform 0.35s ease;
		transition-delay: calc(var(--i, 0) * 120ms);
	}

	[data-landing-cats][data-visible] .cat {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.cat {
			opacity: 1 !important;
			transform: none !important;
			transition: none !important;
		}
	}

	/* ══════════════════════════════════════════════════════════════════
	   PROTOTYPE (dev only) — variant B: flow bands, variant C: manifesto,
	   and the floating switcher bar.
	   ══════════════════════════════════════════════════════════════════ */

	.flows {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 58rem;
		margin: 0 auto;
	}

	.flow {
		display: grid;
		grid-template-columns: 11rem 1fr;
		gap: 1.25rem;
		align-items: center;
	}

	.flow__label {
		font-family: var(--sl-font-mono, ui-monospace, monospace);
		font-size: 0.7rem;
		font-weight: 600;
